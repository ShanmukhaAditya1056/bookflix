# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with e.g.:  openssl rand -base64 48

# --- Host ports (change if 3306 / 8080 are already used on your machine) ---
BOOKFLIX_MYSQL_HOST_PORT=3306
BOOKFLIX_API_PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password
BOOKFLIX_DB_USER=bookflix
BOOKFLIX_DB_PASSWORD=change-me-db-password

# --- Spring Boot API ---
# HS256 signing secret, at least 32 characters.
BOOKFLIX_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Comma-separated list of browser origins allowed to call the API (the Vite dev server by default).
BOOKFLIX_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev

# --- Backend <-> recommendation service (private, never sent to the frontend) ---
BOOKFLIX_ML_INTERNAL_TOKEN=change-me-shared-internal-token

# --- Local development admin (only honoured with the "dev" profile) ---
BOOKFLIX_DEV_ADMIN_ENABLED=false
BOOKFLIX_DEV_ADMIN_EMAIL=admin@example.local
BOOKFLIX_DEV_ADMIN_PASSWORD=change-me-admin-password
